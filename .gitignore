# Build output
build/
cmake-build-*/
out/

# IDE
.vs/
.vscode/
*.suo
*.user
*.sln
*.vcxproj*
.idea/

# OS
Thumbs.db
.DS_Store

# SDL libraries (downloaded separately)
vendor/

# Third-party SDL sources kept next to the project (~240 MB). CMakeLists.txt expects the
# same sources under build/_deps/{sdl3,sdl3_image,sdl3_mixer,sdl3_ttf}-src, so a fresh clone
# needs them downloaded from libsdl.org before configuring.
SDL3-*/
SDL3_image-*/
SDL3_mixer-*/
SDL3_ttf-*/

# Playtest captures (F12 / --shots)
screenshots/

# Blender working files: regenerated by tools/blender/mantle_sprites (run.main(blend=True))
tools/blender/blend/

# Claude Code local permissions
.claude/settings.local.json

# Compiled objects
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Emscripten output
*.wasm
*.js
*.html
!src/**/*.html
